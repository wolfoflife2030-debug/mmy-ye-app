{
  "name": "mmy-ye",
  "version": "1.0.0",
  "description": "MMY.YE — الإعلام الحربي اليمني",
  "author": "Media Platform",
  "main": "electron/main.js",
  "private": true,
  "scripts": {
    "prepare:www": "node scripts/prepare.js",
    "dev": "npm run prepare:www && electron .",
    "win": "npm run prepare:www && electron-builder --win --x64",
    "android:add": "npx cap add android",
    "android:sync": "npm run prepare:www && npx cap sync android",
    "android:open": "npm run android:setup && npm run android:sync && npx cap open android",
    "icons": "npx @capacitor/assets generate --android",
    "android:setup": "node scripts/android-setup.js",
    "android:apk": "npm run android:setup && npm run android:sync && cd android && gradlew.bat assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^6.1.2",
    "@capacitor/core": "^6.1.2",
    "@capacitor/filesystem": "^6.0.1",
    "@capacitor/share": "^6.0.2",
    "@capacitor/status-bar": "^6.0.1"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^6.1.2",
    "@fontsource/cairo": "^5.1.0",
    "@fontsource/tajawal": "^5.1.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "ye.mmy.app",
    "productName": "MMY.YE",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**",
      "www/**",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "language": "1025",
      "shortcutName": "MMY.YE"
    }
  }
}